{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": { "type": "string", "enum": ["data-engineer"] },
    "summary": { "type": "string", "minLength": 1 },
    "schemaChanges": { "type": "array", "items": { "type": "string" } },
    "migrations": { "type": "array", "items": { "type": "string" } },
    "persistenceMappings": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "decision": { "type": "string", "enum": ["handoff"] },
    "nextRole": {
      "type": "string",
      "enum": ["architect", "backend-coder", "frontend-coder", "qa"]
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "required": [
    "role",
    "summary",
    "schemaChanges",
    "migrations",
    "persistenceMappings",
    "tests",
    "artifacts",
    "evidence",
    "decision",
    "nextRole",
    "reason"
  ]
}
