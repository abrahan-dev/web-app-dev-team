{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": { "type": "string", "enum": ["architect"] },
    "summary": { "type": "string", "minLength": 1 },
    "design": { "type": "string", "minLength": 1 },
    "changePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicationName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "persistenceContexts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "dataRequired": { "type": "boolean" },
        "backendRequired": { "type": "boolean" },
        "frontendRequired": { "type": "boolean" }
      },
      "required": [
        "applicationName",
        "contexts",
        "persistenceContexts",
        "dataRequired",
        "backendRequired",
        "frontendRequired"
      ]
    },
    "domainModel": { "type": "array", "items": { "type": "string" } },
    "apiContract": { "type": "array", "items": { "type": "string" } },
    "security": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "reviewStatus": {
      "type": "string",
      "enum": ["not-applicable", "approved", "changes-requested"]
    },
    "reviewFindings": { "type": "array", "items": { "type": "string" } },
    "failureOwner": {
      "type": ["string", "null"],
      "enum": ["data-engineer", "backend-coder", "frontend-coder", null]
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "decision": { "type": "string", "enum": ["handoff"] },
    "nextRole": {
      "type": "string",
      "enum": ["specifier", "ui-designer", "data-engineer", "backend-coder", "frontend-coder", "qa"]
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "required": [
    "role",
    "summary",
    "design",
    "changePlan",
    "domainModel",
    "apiContract",
    "security",
    "constraints",
    "risks",
    "reviewStatus",
    "reviewFindings",
    "failureOwner",
    "artifacts",
    "evidence",
    "decision",
    "nextRole",
    "reason"
  ]
}
