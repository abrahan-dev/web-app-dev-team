{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": { "type": "string", "enum": ["backend-coder"] },
    "summary": { "type": "string", "minLength": 1 },
    "changes": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "apiProcedures": { "type": "array", "items": { "type": "string" } },
    "domainDecisions": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "decision": { "type": "string", "enum": ["handoff"] },
    "nextRole": { "type": "string", "enum": ["architect", "frontend-coder", "qa"] },
    "reason": { "type": "string", "minLength": 1 }
  },
  "required": [
    "role",
    "summary",
    "changes",
    "tests",
    "apiProcedures",
    "domainDecisions",
    "artifacts",
    "evidence",
    "decision",
    "nextRole",
    "reason"
  ]
}
