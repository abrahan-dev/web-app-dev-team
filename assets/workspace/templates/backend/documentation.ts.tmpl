import { createRequire } from "node:module";
import { dirname, resolve } from "node:path";

const require = createRequire(import.meta.url);
const swaggerRoot = dirname(require.resolve("swagger-ui-dist/package.json"));
const documentation = `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>API documentation</title>
    <link rel="stylesheet" href="/docs/swagger-ui.css" />
  </head>
  <body>
    <div id="swagger-ui"></div>
    <script src="/docs/swagger-ui-bundle.js"></script>
    <script>
      SwaggerUIBundle({ url: "/openapi.json", dom_id: "#swagger-ui", deepLinking: true });
    </script>
  </body>
</html>`;

function swaggerAsset(path: string): Response | null {
  const assets: Record<string, { file: string; type: string }> = {
    "/docs/swagger-ui-bundle.js": {
      file: "swagger-ui-bundle.js",
      type: "text/javascript; charset=utf-8",
    },
    "/docs/swagger-ui.css": {
      file: "swagger-ui.css",
      type: "text/css; charset=utf-8",
    },
  };
  const asset = assets[path];

  return asset
    ? new Response(Bun.file(resolve(swaggerRoot, asset.file)), {
        headers: { "content-type": asset.type },
      })
    : null;
}

export function apiDocumentationResponse(url: URL): Response | null {
  if (url.pathname === "/docs" || url.pathname === "/docs/") {
    return new Response(documentation, {
      headers: { "content-type": "text/html; charset=utf-8" },
    });
  }

  if (url.pathname === "/openapi.json") {
    return new Response(Bun.file(resolve(process.cwd(), "openapi.json")), {
      headers: { "content-type": "application/json; charset=utf-8" },
    });
  }

  return swaggerAsset(url.pathname);
}
