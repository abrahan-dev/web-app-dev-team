import { useCallback, useEffect, useState } from "react";

export function App() {
  const [health, setHealth] = useState("Checking services");

  const checkHealth = useCallback(() => {
    setHealth("Checking services");

    fetch("/health")
      .then((response) => {
        if (!response.ok) throw new Error("Health check failed");

        return response.json() as Promise<{ status: string }>;
      })
      .then(({ status }) =>
        setHealth(
          status === "ok" ? "All systems ready" : "Service unavailable",
        ),
      )
      .catch(() => setHealth("Service unavailable"));
  }, []);

  useEffect(() => checkHealth(), [checkHealth]);

  return (
    <main className="app-shell">
      <section className="hero" aria-labelledby="application-title">
        <p className="eyebrow">Web App Dev Team</p>
        <h1 id="application-title">{{applicationName}}</h1>
        <p className="intro">
          Your application is ready for its first feature.
        </p>
        <div className="health" role="status">
          <span aria-hidden="true" />
          {health}
        </div>
        {health === "Service unavailable" ? (
          <button type="button" onClick={checkHealth}>
            Retry health check
          </button>
        ) : null}
      </section>
    </main>
  );
}
