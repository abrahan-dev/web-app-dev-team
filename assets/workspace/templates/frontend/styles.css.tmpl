@import "tailwindcss";

:root {
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  color: #f8fafc;
  background: #080b12;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
}

.app-shell {
  display: grid;
  min-height: 100vh;
  place-items: center;
  padding: 2rem;
  background:
    radial-gradient(circle at 20% 15%, rgb(99 102 241 / 35%), transparent 35%),
    radial-gradient(circle at 80% 85%, rgb(14 165 233 / 25%), transparent 40%),
    #080b12;
}

.hero {
  width: min(46rem, 100%);
  padding: clamp(2rem, 8vw, 5rem);
  border: 1px solid rgb(255 255 255 / 12%);
  border-radius: 2rem;
  background: rgb(15 23 42 / 70%);
  box-shadow: 0 2rem 6rem rgb(0 0 0 / 35%);
  backdrop-filter: blur(1.5rem);
}

.eyebrow {
  margin: 0 0 1rem;
  color: #a5b4fc;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  font-size: clamp(2.75rem, 10vw, 6rem);
  letter-spacing: -0.06em;
  line-height: 0.95;
}

.intro {
  max-width: 32rem;
  margin: 1.5rem 0 2rem;
  color: #cbd5e1;
  font-size: 1.125rem;
  line-height: 1.7;
}

.health {
  display: inline-flex;
  gap: 0.65rem;
  align-items: center;
  padding: 0.7rem 1rem;
  border: 1px solid rgb(52 211 153 / 25%);
  border-radius: 999px;
  color: #a7f3d0;
  background: rgb(6 78 59 / 25%);
  font-size: 0.875rem;
}

.health span {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 1rem #34d399;
}
